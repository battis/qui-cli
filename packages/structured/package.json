  "repository": {
    "type": "git",
    "url": "https://github.com/battis/qui-cli.git",
    "directory": "packages/structured"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "main": "./dist/index.js",
