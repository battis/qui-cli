    "npm-run-all": "catalog:prod",
    "typescript": "catalog:prod"
  },
  "peerDependencies": {
    "@qui-cli/colors": "catalog:peers",
    "@qui-cli/core": "catalog:peers",
    "@qui-cli/plugin": "catalog:peers"
